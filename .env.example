# Datapass Mongo Control
#
# MODE A — safe seed-only UI preview.
DATAPASS_CONTROL_DISABLED=true
DATAPASS_CONTROL_WRITE_ENABLED=false
MONGOKU_READ_ONLY_MODE=true
MONGOKU_DISABLE_DEFAULT_HOSTS=true

# MODE B — private read-only multi-authority reporting.
# Keep Mongoku-owned control persistence disabled. Configure Mongo connections as
# secrets and bind logical source IDs to those configured connections.
#
# DATAPASS_CONTROL_DISABLED=true
# DATAPASS_CONTROL_WRITE_ENABLED=false
# MONGOKU_READ_ONLY_MODE=true
# MONGOKU_DISABLE_DEFAULT_HOSTS=false
# MONGOKU_DEFAULT_HOST="mongodb+srv://<global-secret>@<global-host>/;mongodb+srv://<pm-secret>@<pm-host>/;mongodb+srv://<core-secret>@<core-host>/;mongodb+srv://<archive-secret>@<archive-host>/"
#
# The "server" value is a configured Mongoku connection name/host key or id.
# Database names can be overridden here; otherwise the source catalog default is used.
# DATAPASS_SOURCE_BINDINGS='{
#   "DATAPROJECTS_GLOBAL":{"server":"<global-host-key>","database":"dataprojects_control"},
#   "FOIL_PM":{"server":"<pm-host-key>","database":"foil_project_management"},
#   "FOIL_CORE":{"server":"<core-host-key>","database":"foil_control"},
#   "FOIL_WORK_ARCHIVE":{"server":"<archive-host-key>","database":"foil_work_archive"},
#   "FOIL_STUDY":{"server":"<study-host-key>","database":"foil_study"},
#   "FOIL_AI_REASONING":{"server":"<ai-reasoning-host-key>"},
#   "FOIL_IT_DEV":{"server":"<it-dev-host-key>","database":"foil_it_dev"},
#   "FOIL_FRONT":{"server":"<front-host-key>","database":"foil_front"},
#   "FOIL_DATABRICKS":{"server":"<databricks-host-key>","database":"foil_lab"},
#   "FOIL_FABRIC":{"server":"<fabric-host-key>","database":"foil_fabric_lab"}
# }'

#
# Optional resource-level bindings. This is useful when PM resource_registry
# resource IDs are more stable than logical source IDs. PM registry metadata is
# still read first; these bindings only resolve the private configured server.
# DATAPASS_RESOURCE_BINDINGS='{
#   "RES-MONGO-DB-PM":{"server":"<pm-host-key>","database":"foil_project_management"},
#   "RES-MONGO-DB-CORE-CONTROL":{"server":"<core-host-key>","database":"foil_control"},
#   "RES-MONGO-DB-WORK-ARCHIVE":{"server":"<archive-host-key>","database":"foil_work_archive"}
# }'

# MODE C — optional Mongoku-owned configuration/history persistence.
# DO NOT enable this until an explicit architectural decision selects the exact
# existing/new server and database. There is intentionally no default database.
#
# DATAPASS_CONTROL_DISABLED=false
# DATAPASS_CONTROL_WRITE_ENABLED=true
# DATAPASS_CONTROL_SERVER=<explicit configured Mongoku host name or id>
# DATAPASS_CONTROL_DATABASE=<explicitly approved database name>

# Vercel/serverless filesystem: only use ephemeral temp storage for Mongoku's
# connection-list file. Durable project truth never lives here.
MONGOKU_DATABASE_FILE=/tmp/.mongoku.db
