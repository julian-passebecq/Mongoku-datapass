# Datapass Mongo Control
# Safe seed-only mode (recommended for a public preview)
DATAPASS_CONTROL_DISABLED=true
DATAPASS_CONTROL_WRITE_ENABLED=false
MONGOKU_READ_ONLY_MODE=true
MONGOKU_DISABLE_DEFAULT_HOSTS=true

# Private Mongo-connected mode
# DATAPASS_CONTROL_DISABLED=false
# DATAPASS_CONTROL_WRITE_ENABLED=true
# DATAPASS_CONTROL_DATABASE=datapass_control
# DATAPASS_CONTROL_SERVER=<configured Mongoku host name or id>
# MONGOKU_DEFAULT_HOST=mongodb+srv://<user>:<password>@<cluster>/<db>

# Vercel/serverless filesystem: only use ephemeral temp storage.
MONGOKU_DATABASE_FILE=/tmp/.mongoku.db
